ADDR=:8080
DATABASE_URL=postgres://user:password@localhost:5432/adelson?sslmode=disable
JWT_SECRET=replace-with-a-long-random-secret
SERVICE_TOKEN=replace-with-a-secret-for-workers-and-webhooks
# WhatsApp Business Cloud API (Meta for Developers). El bot responde y deriva a un humano.
# WHATSAPP_APP_SECRET: App Secret (Configuración de la app > Básica), valida X-Hub-Signature-256.
# WHATSAPP_TOKEN: token de acceso (System User para producción; el temporal dura 24 h).
# WHATSAPP_PHONE_NUMBER_ID: ID del número (WhatsApp > API Setup).
# El verify token del webhook (GET) es SERVICE_TOKEN.
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
TELEGRAM_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://inmobiliariafront.joaquinr-val.workers.dev
MEDIA_BASE_URL=https://inmobiliariafront.joaquinr-val.workers.dev/media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=adelson-inmuebles
R2_PRESIGN_TTL=300
R2_MAX_UPLOAD_BYTES=8388608
